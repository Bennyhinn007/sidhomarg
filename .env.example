# Public address of the website, without a trailing slash.
# Used for canonical URLs, hreflang links, the sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://www.example.org

# Set to "false" on preview/staging deployments to block search engines.
NEXT_PUBLIC_ALLOW_INDEXING=true

# Website visit counter (Upstash Redis REST API). Server-side only: never prefix with NEXT_PUBLIC_.
# Leave empty to hide the counter. Get both values from the Upstash console → your database → REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: any random string, used when hashing visitor fingerprints.
VISIT_COUNTER_SALT=
